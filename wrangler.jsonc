// Rounds — Cloudflare Workers config.
// Vite builds the front end into dist/client (served free as static assets); /api/* goes to the Worker.
// SESSION_SECRET is set with `wrangler secret put SESSION_SECRET`, never here.
// Accounts are created with `npm run user:add -- <username> --remote`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rounds",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "preview_urls": false,

  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },

  // rounds-v7 was built fresh from migrations/0001_schema.sql and filled by
  // scripts/move-db.mjs from rounds-v6 on 2026-10-05 (courses, items and the change feed by scope).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rounds-v7",
      "database_id": "28f27774-ca21-4ef7-a2ac-416c22b462d0",
      "migrations_dir": "migrations"
    }
  ],

  // Spotify: the app's client id is public; the secret is set with
  // `wrangler secret put SPOTIFY_CLIENT_SECRET`. Both empty means the player is off.
  // CF_ACCOUNT_ID is public; the Admin page's traffic also needs CF_ANALYTICS_TOKEN, a
  // secret API token with only "Account Analytics: Read" (see worker/analytics.js).
  // Term Pro (worker/plans.js, docs/MONETIZATION.md): PAYWALL "on" limits the free plan; off,
  // everyone gets Pro's features. BILLING_SANDBOX "on" lets TestFlight's sandbox purchases
  // count. REVENUECAT_WEBHOOK_SECRET is a secret. MIN_APP_VERSION: older iPhone and Mac
  // builds are asked to update (worker/app.js); empty asks none.
  "vars": {
    "SPOTIFY_CLIENT_ID": "e553fc57814a408c946519bda5263f5e",
    "CF_ACCOUNT_ID": "2c6057041650be9d99932b4013571adb",
    "PAYWALL": "off",
    "BILLING_SANDBOX": "off",
    "MIN_APP_VERSION": ""
  },

  // Workers AI reads uploaded course outlines (free daily allowance; see worker/outline.js).
  // Workers AI always runs remotely, even under `wrangler dev`; saying so silences the warning.
  "ai": { "binding": "AI", "remote": true },

  "triggers": {
    // Nightly: hard-delete tombstones older than 30 days.
    "crons": ["0 3 * * *"]
  },

  "observability": { "enabled": true },

  // `npm run dev` always serves http://127.0.0.1:8787, the redirect URI registered with
  // Spotify. If the port is taken it fails rather than moving to another one.
  "dev": { "ip": "127.0.0.1", "port": 8787 }
}
