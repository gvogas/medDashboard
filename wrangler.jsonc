// Rounds — Cloudflare Workers config.
// Vite builds the front end into dist/client (served free as static assets); /api/* goes to the Worker.
// SESSION_SECRET is set with `wrangler secret put SESSION_SECRET`, never here.
// Accounts are created with `npm run user:add -- <username> --remote`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rounds",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "preview_urls": false,

  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },

  // rounds-v3 was built fresh from migrations/0001_schema.sql and filled by
  // scripts/move-db.mjs on 2026-09-25. The databases before it have been deleted.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rounds-v3",
      "database_id": "94de2d33-2cbd-4169-9398-faf3b3895f95",
      "migrations_dir": "migrations"
    }
  ],

  // Spotify: the app's client id is public; the secret is set with
  // `wrangler secret put SPOTIFY_CLIENT_SECRET`. Both empty means the player is off.
  "vars": { "SPOTIFY_CLIENT_ID": "e553fc57814a408c946519bda5263f5e" },

  // Workers AI reads uploaded course outlines (free daily allowance; see worker/outline.js).
  // Workers AI always runs remotely, even under `wrangler dev`; saying so silences the warning.
  "ai": { "binding": "AI", "remote": true },

  "triggers": {
    // Nightly: hard-delete tombstones older than 30 days.
    "crons": ["0 3 * * *"]
  },

  "observability": { "enabled": true },

  // `npm run dev` always serves http://127.0.0.1:8787, the redirect URI registered with
  // Spotify. If the port is taken it fails rather than moving to another one.
  "dev": { "ip": "127.0.0.1", "port": 8787 }
}
