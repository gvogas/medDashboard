// Rounds — Cloudflare Workers config.
// Vite builds the front end into dist/client (served free as static assets); /api/* goes to the Worker.
// SESSION_SECRET is set with `wrangler secret put SESSION_SECRET`, never here.
// Accounts are created with `npm run user:add -- <username> --remote`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rounds",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "preview_urls": false,

  // The API makes two or more D1 round trips a request (the session's check and limit, then the
  // route): Smart Placement may run it near the database rather than near the person. Static
  // files are still served from the nearest location. Free on every plan.
  "placement": { "mode": "smart" },

  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },

  // rounds-v8 was built fresh from migrations/0001_schema.sql (0001-0009 folded into one) and
  // filled by scripts/move-db.mjs from rounds-v7 on 2026-10-22.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rounds-v8",
      "database_id": "c4f807a5-0755-418f-9a39-455e87703afd",
      "migrations_dir": "migrations"
    }
  ],

  // Spotify: the app's client id is public; the secret is set with
  // `wrangler secret put SPOTIFY_CLIENT_SECRET`. Both empty means the player is off.
  // CF_ACCOUNT_ID is public; the Admin page's traffic also needs CF_ANALYTICS_TOKEN, a
  // secret API token with only "Account Analytics: Read" (see worker/analytics.js).
  // TURNSTILE_SITE_KEY is public; TURNSTILE_HOSTNAMES lists the hostnames a sign-in CAPTCHA may come
  // from (worker/captcha.js). The secret is `wrangler secret put TURNSTILE_SECRET`.
  "vars": { "SPOTIFY_CLIENT_ID": "e553fc57814a408c946519bda5263f5e", "CF_ACCOUNT_ID": "2c6057041650be9d99932b4013571adb", "TURNSTILE_SITE_KEY": "0x4AAAAAAFqKDv8zUmJcnyVj", "TURNSTILE_HOSTNAMES": "rounds.termanitor07.workers.dev" },

  // Workers AI reads uploaded course outlines (free daily allowance; see worker/outline.js).
  // Workers AI always runs remotely, even under `wrangler dev`; saying so silences the warning.
  "ai": { "binding": "AI", "remote": true },

  "triggers": {
    // Nightly: hard-delete tombstones older than 30 days. Hourly: the morning digests
    // (worker/push.js; worker/index.js tells the two apart by the cron string).
    "crons": ["0 3 * * *", "0 * * * *"]
  },

  // Every signed-in request's budget, and the Spotify routes' (worker/limits.js limitUser): counted
  // by Cloudflare, so a request writes nothing to D1. Per account, per minute, in each location.
  // The limits match API_LIMIT and SPOTIFY_LIMIT there.
  "ratelimits": [
    { "name": "API_LIMITER", "namespace_id": "1001", "simple": { "limit": 600, "period": 60 } },
    { "name": "SPOTIFY_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
  ],

  "observability": { "enabled": true },
  // A test copy of the site, `npm run deploy:staging` (docs/DEPLOYING.md, "Staging"): its own
  // Worker (rounds-staging), its own empty database and its own secrets, so a change can be
  // tried against the real Workers AI and real push before it reaches main. Spotify is off
  // there (its redirect URI is the live site's). Bindings, vars and crons are not inherited
  // from the top level, so each is repeated here.
  "env": {
    "staging": {
      "name": "rounds-staging",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "rounds-staging",
          // `npx wrangler d1 create rounds-staging` prints the id to put here.
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "vars": { "SPOTIFY_CLIENT_ID": "", "CF_ACCOUNT_ID": "2c6057041650be9d99932b4013571adb" },
      "ai": { "binding": "AI", "remote": true },
      "ratelimits": [
        { "name": "API_LIMITER", "namespace_id": "2001", "simple": { "limit": 600, "period": 60 } },
        { "name": "SPOTIFY_LIMITER", "namespace_id": "2002", "simple": { "limit": 60, "period": 60 } }
      ],
      "triggers": { "crons": ["0 3 * * *", "0 * * * *"] }
    }
  },

  // `npm run dev` always serves http://127.0.0.1:8787, the redirect URI registered with
  // Spotify. If the port is taken it fails rather than moving to another one.
  "dev": { "ip": "127.0.0.1", "port": 8787 }
}
