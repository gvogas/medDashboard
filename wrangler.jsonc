// Rounds — Cloudflare Workers config.
// Static files in public/ are served for free; /api/* goes to the Worker.
// GOOGLE_CLIENT_ID comes from the Google Cloud OAuth client (phase 0 of PLAN.md).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rounds",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-01",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rounds",
      "database_id": "61d75810-5015-41f5-8b3e-fc2339d4acf1",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    // Public identifier of the Google OAuth web client. Not a secret.
    "GOOGLE_CLIENT_ID": "",
    // Comma-separated list to pin the app to specific accounts. Empty = open sign-up.
    "ALLOWED_EMAILS": ""
  },

  // SESSION_SECRET is set with `wrangler secret put SESSION_SECRET`, never here.

  "triggers": {
    // Nightly: hard-delete tombstones older than 30 days.
    "crons": ["0 3 * * *"]
  },

  "observability": { "enabled": true }
}
