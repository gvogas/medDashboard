// Rounds — Cloudflare Workers config.
// Static files in public/ are served for free; /api/* goes to the Worker.
// SESSION_SECRET is set with `wrangler secret put SESSION_SECRET`, never here.
// Accounts are created with `npm run user:add -- <username> --remote`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rounds",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "preview_urls": false,

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rounds",
      "database_id": "61d75810-5015-41f5-8b3e-fc2339d4acf1",
      "migrations_dir": "migrations"
    }
  ],

  // Spotify: the app's client id is public; the secret is set with
  // `wrangler secret put SPOTIFY_CLIENT_SECRET`. Both empty means the player is off.
  "vars": { "SPOTIFY_CLIENT_ID": "e553fc57814a408c946519bda5263f5e" },

  "triggers": {
    // Nightly: hard-delete tombstones older than 30 days.
    "crons": ["0 3 * * *"]
  },

  "observability": { "enabled": true },

  // `npm run dev` always serves http://127.0.0.1:8787, the redirect URI registered with
  // Spotify. If the port is taken it fails rather than moving to another one.
  "dev": { "ip": "127.0.0.1", "port": 8787 }
}
