# Wrangler local state and dev secrets
.wrangler/
.dev.vars
.dev.vars.*
!.dev.vars.example

# Credentials — never commit these.
# Note: GOOGLE_CLIENT_ID in wrangler.jsonc is a public identifier, not a secret.
# SESSION_SECRET is set with `wrangler secret put` and never lives in a file.
.env
.env.*

# Node
node_modules/
npm-debug.log*

# Editors and OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
Desktop.ini

# The Vite build. It also holds a copy of .dev.vars, made for `vite preview`.
dist/

# Brainstorming mockups, and anything of Claude's (Claude Code settings, worktrees,
# CLAUDE.md notes, MCP config)
.superpowers/
.claude/
.claude*
*claude*
*CLAUDE*
*Claude*
.mcp.json
e2e/out/
