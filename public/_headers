# Security headers for every static file. The API sets its own in worker/api.js.
# The script-src hash is the inline theme script in index.html; regenerate it if
# that script changes: `node scripts/csp-hash.mjs` prints it.
# sdk.scdn.co is Spotify's Web Playback SDK and the frame it plays in; the frame
# streams under its own origin. Artwork uses i.scdn.co and playlist mosaics use
# mosaic.scdn.co; allow those hosts only for images.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-npPDegaqv7XOEqrQQ0qhMPq6UPATWIrUAHU0FNaVCfs=' https://sdk.scdn.co; frame-src https://sdk.scdn.co; style-src 'self' https://fonts.googleapis.com; style-src-attr 'none'; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://i.scdn.co https://mosaic.scdn.co; connect-src 'self'; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin

# Cache-Control is set per path, not on /* above: two matching rules would have
# their values joined with a comma. Anything unlisted gets the platform default,
# `public, max-age=0, must-revalidate`.
# Vite puts every script and stylesheet under /assets/ with a content hash in its
# name, so a URL there never changes its content and need not be revalidated.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The entry points that name the current release must always be checked.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
