{
  "name": "rounds",
  "private": true,
  "type": "module",
  "description": "Med-school tracker: static front end + Cloudflare Worker API on D1",
  "scripts": {
    "dev": "vite",
    "dev:built": "npm run build && vite preview",
    "dev:fake-ai": "vite --mode fake-ai",
    "deploy": "npm run check && node scripts/check-secrets.mjs && wrangler d1 migrations apply DB --config wrangler.jsonc --remote && node scripts/check-db.mjs --remote && wrangler deploy",
    "deploy:staging": "node scripts/deploy-staging.mjs",
    "test": "vitest run && npm run test:local",
    "test:watch": "vitest",
    "test:ui": "vitest run --project dom",
    "test:api": "vitest run --project workers",
    "test:changed": "vitest run --changed",
    "db:local": "wrangler d1 migrations apply DB --config wrangler.jsonc --local",
    "db:remote": "wrangler d1 migrations apply DB --config wrangler.jsonc --remote",
    "db:staging": "wrangler d1 migrations apply DB --config wrangler.jsonc --env staging --remote",
    "db:check": "node scripts/check-db.mjs",
    "user:add": "node scripts/add-user.mjs",
    "build": "vite build && node scripts/build.mjs",
    "csp:update": "node scripts/csp-hash.mjs --write",
    "test:local": "node --test test/local-store.node.mjs test/syntax.node.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "spotify:key": "node scripts/spotify-key.mjs",
    "push:key": "node scripts/vapid-key.mjs"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "sharp": "^0.35.5",
    "miniflare": {
      "undici": "^7.30.1"
    }
  },
  "dependencies": {
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "clsx": "^2.1.1",
    "framer-motion": "^13.5.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  }
}
